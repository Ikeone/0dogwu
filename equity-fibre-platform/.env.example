# =============================================================================
# Wireless Nation Equity Fibre platform — example environment
# Copy to `.env.local` for local development:  cp .env.example .env.local
#
# NEVER commit `.env` or `.env.local`. Generate strong local secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

APP_ENV=development
DEMO_MODE=true
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# --- Persistence -------------------------------------------------------------
# Demo uses SQLite (file DB) so the demo runs with zero infrastructure.
# Production MUST use PostgreSQL — see docs/DEPLOYMENT.md.
DATABASE_URL=file:./dev.db

# --- Security ----------------------------------------------------------------
# Generate unique random values. The demo defaults below are DEMO ONLY and the
# app refuses to start in production if these placeholder values are detected.
AUTH_SECRET=dev-only-insecure-change-me
FIELD_ENCRYPTION_KEY=dev-only-insecure-change-me-32byte
SESSION_COOKIE_NAME=wn_session

# --- Payments ----------------------------------------------------------------
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Address / Chorus provisioning ------------------------------------------
ADDRESS_PROVIDER=mock
PROVISIONING_PROVIDER=mock
CHORUS_ENVIRONMENT=mock
CHORUS_BASE_URL=
CHORUS_TOKEN_URL=
CHORUS_CLIENT_ID=
CHORUS_CLIENT_SECRET=
CHORUS_SCOPE=
CHORUS_WEBHOOK_SECRET=
CHORUS_PROVIDER_ACCOUNT_ID=

# --- Wholesale provisioning provider (Feenix/Phoenix/WN — TBC) ---------------
WHOLESALE_PROVIDER_NAME=
WHOLESALE_PROVIDER_BASE_URL=
WHOLESALE_PROVIDER_API_KEY=
WHOLESALE_PROVIDER_WEBHOOK_SECRET=

# --- Shipping / courier ------------------------------------------------------
SHIPPING_PROVIDER=mock
SHIPPING_BASE_URL=
SHIPPING_API_KEY=
SHIPPING_WEBHOOK_SECRET=

# --- Notifications -----------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=hello@equityfibre.example.nz
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER=

# --- AI support --------------------------------------------------------------
# knowledge_base = deterministic KB search (no external key required).
# anthropic = grounded LLM answers (requires ANTHROPIC_API_KEY, server-side).
AI_PROVIDER=knowledge_base
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Object storage (eligibility evidence) -----------------------------------
# local = encrypted-at-rest private files under ./storage (demo only).
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
AWS_REGION=ap-southeast-6

# --- Observability / bot protection -----------------------------------------
ERROR_MONITORING_DSN=
CAPTCHA_PROVIDER=disabled
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
