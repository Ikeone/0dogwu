# Dependencies
node_modules/
.pnp
.pnp.js

# Environment / secrets — never commit
.env
.env.local
.env.*.local
*.pem

# Build output
.next/
out/
dist/
build/

# Prisma local dev database (synthetic demo data only, but keep out of git)
prisma/dev.db
prisma/dev.db-journal
prisma/*.db
prisma/*.db-journal
# Guard against Prisma's relative-path quirk creating a nested db
prisma/prisma/

# Local object storage for evidence uploads (never commit uploaded files)
storage/

# Test / tooling
coverage/
playwright-report/
test-results/
.vitest/

# Logs and OS
*.log
.DS_Store
